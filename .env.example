# ===================================================
# The Connector Headless API Server - Configuration
# ===================================================

# Server bind settings: 0.0.0.0 enables LAN access; use 127.0.0.1 or --local for local only.
HOST=0.0.0.0
# BACKEND_HOST takes precedence over HOST.
# BACKEND_HOST=0.0.0.0
# Ports are initialized from port_mapping.json ("connector_port": 8301) and saved in %APPDATA%/the_connector/settings.json.
# CLI --port or BACKEND_PORT overrides the port for a single run.
# BACKEND_PORT=8301
CONNECTOR_DEBUG=false

# User preferences: %APPDATA%\the_connector\settings.json on Windows;
# $XDG_CONFIG_HOME/the_connector/settings.json or ~/.config/the_connector/settings.json elsewhere.
# CONNECTOR_SETTINGS_PATH=C:/path/to/settings.json
# DATA_DIR overrides the JSON preference.
# DATA_DIR=C:/path/to/Connector Data
# The database defaults to <data_dir>/connector.db.
# DB_PATH=C:/path/to/connector.db
# Installed plugin files/environments default to <data_dir>/plugins.
# PLUGIN_DIR=C:/path/to/Connector Data/plugins

# Agent Python defaults to <data_dir>/python; named environments to <data_dir>/python_envs.
# AGENT_PYTHON_ENV_DIR=C:/path/to/Connector Data/python
# AGENT_PYTHON_ENVS_DIR=C:/path/to/Connector Data/python_envs
# CONNECTOR_PYTHON_EXECUTABLE=C:/path/to/Python312/python.exe
# JOBS_DIR=C:/path/to/Connector Data/jobs

# Logging and Diagnostics
COMPLETION_NO_DATABASE_ACCESS=false
RESPONSE_LOGGING_ENABLED=true
# RESPONSE_LOG_DIR=C:/path/to/logs
RESPONSE_LOG_MAX_BYTES=10485760
RESPONSE_LOG_BACKUP_COUNT=5
RESPONSE_LOG_MAX_BODY_BYTES=0
REQUEST_LOG_MAX_BODY_BYTES=0
INTERNAL_AUDIT_ENABLED=true
INTERNAL_AUDIT_MAX_BYTES=10485760
INTERNAL_AUDIT_MAX_ENTRIES=5

# LLM Provider API Keys (Set any that you wish to use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama Local Host
OLLAMA_HOST=http://localhost:11434

# Optional Kokoro Speech Backend (Disabled/optional by default in headless mode)
# KOKORO_BASE_URL=http://127.0.0.1:8131
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_TIMEOUT=120

# Default Provider & Model
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_CONTEXT_WINDOW=10
